<?php
// Load environment variable instead of hardcoding the secret string
$xenditApiKey = getenv('XENDIT_SECRET_KEY');
$client_id     = getenv('GOOGLE_CLIENT_ID');
$client_secret = getenv('GOOGLE_CLIENT_SECRET');
$redirect_uri  = getenv('GOOGLE_REDIRECT_URI') ?: 'http://localhost/HouseAndLotApp/google-callback.php';
?>